{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japan-graduation-trip-survey",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japan-trip-survey-db",
      "database_id": "beb5164f-8acd-429d-a4d1-78d1b8e2e7dc"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SURVEY_ROOM",
        "class_name": "SurveyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SurveyRoom"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ADMIN_PASSWORD_HASH": "JpTrip2026!Admin#Sec"
  }
}
